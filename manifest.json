{
  "manifest_version": 3,
  "name": "HUB",
  "version": "0.2.0",
  "description": "Your channel board is the only door into YouTube. Open it any other way and the page blurs until you pick a channel.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "HUB",
    "default_popup": "ext/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "ext/background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": [
        "ext/scope.js",
        "ext/guard.js"
      ],
      "css": [
        "ext/guard.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "css/*",
        "js/*",
        "icons/*",
        "ext/overlay.css"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ]
    }
  ]
}
